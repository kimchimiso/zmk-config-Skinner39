#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        function {
            bindings = <&mo 3>;
            key-positions = <37 34>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q             &kp W         &kp E      &kp R    &kp T                                                 &kp Y          &kp U    &kp I      &kp O       &kp P
  &kp A             &lt 2 S       &lt 7 D    &lt 1 F  &kp G                                                 &kp H          &lt 1 J  &lt 7 K    &lt 2 L     &kp SEMICOLON
  &mt LEFT_SHIFT Z  &kp X         &kp C      &kp V    &kp B                                                 &kp N          &kp M    &kp COMMA  &kp PERIOD  &mt RIGHT_SHIFT MINUS
  &kp LEFT_COMMAND  &kp LEFT_ALT  &kp LCTRL  &mo 2    &mt LEFT_SHIFT SPACE  &mo 1  &mt RIGHT_COMMAND ENTER  &kp BACKSPACE                                  &kp SLASH
            >;
        };

        number {
            bindings = <
  &kp ASTRK       &kp PERCENT   &kp LESS_THAN  &kp GREATER_THAN  &kp DOLLAR                     &kp NON_US_BACKSLASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS  &kp EQUAL
  &kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4      &kp N5                         &kp NUMBER_6          &kp N7                &kp NUMBER_8           &kp N9    &kp N0
  &kp LEFT_SHIFT  &none         &none          &kp CARET         &none                          &none                 &none                 &trans                 &trans    &trans
  &trans          &trans        &trans         &trans            &trans      &trans  &kp ENTER  &trans                                                                       &trans
            >;
        };

        number+shift {
            bindings = <
  &none            &kp GRAVE          &kp APOSTROPHE    &none              &none                        &kp TILDE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS  &kp EQUAL
  &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PIPE                     &kp AMPERSAND  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &none     &kp COLON
  &trans           &none              &none             &kp HASH           &none                        &kp AT         &kp UNDER             &trans                 &trans    &mt RIGHT_SHIFT QUESTION
  &trans           &trans             &trans            &trans             &trans    &trans  &kp ENTER  &trans                                                                &kp BACKSLASH
            >;
        };

        function {
            bindings = <
  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                         &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                        &kp F16  &kp F17  &kp F18  &kp F19  &kp F20
  &kp F21  &kp F22  &kp F23  &kp F24  &bt BT_CLR                     &none    &none    &none    &none    &kp LC(LG(SPACE))
  &trans   &trans   &trans   &trans   &trans      &trans  &kp ENTER  &trans                              &none
            >;
        };

        empty {
            bindings = <
  &none   &none   &none   &none   &none                   &none   &none  &none   &none   &none
  &none   &none   &none   &none   &none                   &none   &none  &none   &none   &none
  &none   &none   &none   &none   &none                   &none   &none  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans
            >;
        };

        layer_5_mouse_scroll {
            bindings = <
  &none   &none   &none   &none   &none                   &none   &none  &none   &none   &none
  &none   &none   &none   &none   &none                   &none   &none  &none   &none   &none
  &none   &none   &none   &none   &none                   &none   &none  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans
            >;
        };

        layer_6_mouse_slow {
            bindings = <
  &none   &none   &none   &none   &none                   &none   &none  &none   &none   &none
  &none   &none   &none   &none   &none                   &none   &none  &none   &none   &none
  &none   &none   &none   &none   &none                   &none   &none  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans
            >;
        };

        cursor {
            bindings = <
  &kp ESCAPE      &kp LANGUAGE_2  &none   &kp UP_ARROW    &kp HOME                  &mkp MB4         &msc MOVE_Y(-15)  &none  &kp LANGUAGE_1  &none
  &kp TAB         &kp LEFT        &mo 3   &kp RIGHT       &kp END                   &mkp MB5         &mkp LCLK         &mo 3  &mkp RCLK       &mkp MCLK
  &kp LEFT_SHIFT  &none           &none   &kp DOWN_ARROW  &none                     &msc MOVE_X(15)  &msc MOVE_Y(15)   &none  &none           &msc MOVE_X(-15)
  &trans          &trans          &trans  &trans          &trans    &trans  &trans  &trans                                                    &none
            >;
        };
    };
};
