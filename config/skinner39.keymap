#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        function {
            bindings = <&mo 3>;
            key-positions = <37 34>;
        };

        bt_clr_L {
            bindings = <&bt BT_CLR>;
            key-positions = <0 4>;
        };

        bt_clr_R {
            bindings = <&bt BT_CLR>;
            key-positions = <5 9>;
        };
    };

    macros {
        btl: bluetooth_profile {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER &macro_param_2to1 &to MACRO_PLACEHOLDER>;
            label = "BLUETOOTH_PROFILE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q             &kp W         &kp E      &kp R  &kp T                                                 &kp Y          &kp U    &kp I      &kp O       &lt 6 P
  &kp A             &lt 3 S       &lt 4 D    &kp F  &kp G                                                 &kp H          &kp J    &lt 4 K    &lt 3 L     &kp SEMICOLON
  &kp Z             &kp X         &kp C      &kp V  &kp B                                                 &kp N          &lt 5 M  &kp COMMA  &kp PERIOD  &kp MINUS
  &kp LEFT_COMMAND  &kp LEFT_ALT  &kp LCTRL  &mo 2  &mt LEFT_SHIFT SPACE  &mo 1  &mt RIGHT_COMMAND ENTER  &kp BACKSPACE                                  &kp SLASH
            >;
        };

        number {
            bindings = <
  &kp ASTRK     &kp PERCENT   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp DOLLAR                  &kp LA(Y)     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS  &kp EQUAL
  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp N5                      &kp NUMBER_6  &kp N7                &kp NUMBER_8           &kp N9    &kp N0
  &none         &none         &kp LESS_THAN     &kp GREATER_THAN   &kp CARET                   &none         &none                 &trans                 &trans    &trans
  &trans        &trans        &trans            &trans             &trans      &trans  &trans  &trans                                                               &trans
            >;
        };

        symbol {
            bindings = <
  &none            &kp SINGLE_QUOTE   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE                  &kp TILDE      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PLUS  &kp EQUAL
  &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH          &none              &kp PIPE                   &kp AMPERSAND  &kp LEFT_BRACE        &kp RIGHT_BRACE        &none     &kp COLON
  &none            &none              &kp LESS_THAN     &kp GREATER_THAN   &none                      &kp AT         &kp UNDER             &trans                 &trans    &mt RIGHT_SHIFT QUESTION
  &trans           &trans             &trans            &trans             &trans     &trans  &trans  &trans                                                                &kp BACKSLASH
            >;
        };

        function {
            bindings = <
  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &kp F16  &kp F17  &kp F18  &kp F19  &kp F20
  &kp F21  &kp F22  &kp F23  &kp F24  &none                    &none    &none    &none    &none    &none
  &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                              &none
            >;
        };

        cursor {
            bindings = <
  &kp ESCAPE      &kp LANGUAGE_2  &none   &kp UP_ARROW    &kp HOME                  &mkp MB4         &msc MOVE_Y(-15)  &none  &kp LANGUAGE_1  &none
  &kp TAB         &kp LEFT        &none   &kp RIGHT       &kp END                   &mkp MB5         &mkp LCLK         &none  &mkp RCLK       &mkp MCLK
  &kp LEFT_SHIFT  &none           &none   &kp DOWN_ARROW  &none                     &msc MOVE_X(15)  &msc MOVE_Y(15)   &none  &none           &msc MOVE_X(-15)
  &trans          &trans          &trans  &trans          &trans    &trans  &trans  &trans                                                    &none
            >;
        };

        player {
            bindings = <
  &kp K_MUTE  &trans  &trans  &kp C_VOLUME_UP    &trans                  &trans  &trans  &trans  &trans  &trans
  &trans      &trans  &trans  &trans             &trans                  &trans  &trans  &trans  &trans  &trans
  &trans      &trans  &trans  &kp C_VOLUME_DOWN  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans      &trans  &trans  &trans             &trans  &trans  &trans  &trans                          &trans
            >;
        };

        profile {
            bindings = <
  &none     &none     &none     &none     &none                     &none   &none  &none  &none  &none
  &btl 0 0  &btl 1 0  &btl 2 0  &btl 3 7  &btl 4 0                  &none   &none  &none  &none  &none
  &none     &none     &none     &none     &none                     &none   &none  &none  &none  &none
  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans                       &trans
            >;
        };

        default_layer_win {
            bindings = <
  &kp Q             &kp W         &kp E      &kp R  &kp T                                                 &kp Y          &kp U     &kp I      &kp O       &lt 13 P
  &kp A             &lt 10 S      &lt 11 D   &kp F  &kp G                                                 &kp H          &kp J     &lt 11 K   &lt 10 L    &kp SEMICOLON
  &kp Z             &kp X         &kp C      &kp V  &kp B                                                 &kp N          &lt 12 M  &kp COMMA  &kp PERIOD  &kp MINUS
  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LCTRL  &mo 9  &mt LEFT_SHIFT SPACE  &mo 8  &mt RIGHT_CONTROL ENTER  &kp BACKSPACE                                   &kp SLASH
            >;
        };

        number_win {
            bindings = <
  &kp DOUBLE_QUOTES  &kp PERCENT   &kp RIGHT_BRACKET  &kp BACKSLASH     &kp DOLLAR                  &kp INT_YEN   &kp ASTRK  &kp LEFT_PARENTHESIS  &kp COLON  &kp UNDER
  &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3       &kp NUMBER_4      &kp N5                      &kp NUMBER_6  &kp N7     &kp NUMBER_8          &kp N9     &kp N0
  &none              &none         &kp LESS_THAN      &kp GREATER_THAN  &kp EQUAL                   &none         &none      &trans                &trans     &trans
  &trans             &trans        &trans             &trans            &trans      &trans  &trans  &trans                                                    &trans
            >;
        };

        symbol_win {
            bindings = <
  &none            &kp AMPS  &kp RIGHT_BRACKET  &kp BACKSLASH     &kp LS(LEFT_BRACKET)                     &kp PLUS          &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp COLON  &kp UNDER
  &kp EXCLAMATION  &kp AT    &kp HASH           &none             &kp LS(INTERNATIONAL_3)                  &kp CARET         &kp LEFT_BRACE  &kp PIPE              &none      &kp SINGLE_QUOTE
  &none            &none     &kp LESS_THAN      &kp GREATER_THAN  &none                                    &kp LEFT_BRACKET  &kp LS(MINUS)   &trans                &trans     &mt RIGHT_SHIFT QUESTION
  &trans           &trans    &trans             &trans            &trans                   &trans  &trans  &trans                                                             &kp INTERNATIONAL_3
            >;
        };

        function_win {
            bindings = <
  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &kp F6   &kp F7   &kp F8   &kp F9             &kp F10
  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &kp F16  &kp F17  &kp F18  &kp RIGHT_COMMAND  &kp F20
  &kp F21  &kp F22  &kp F23  &kp F24  &none                    &none    &none    &none    &none              &none
  &trans   &trans   &trans   &trans   &trans   &trans  &trans  &trans                                        &none
            >;
        };

        cursor_win {
            bindings = <
  &kp ESCAPE      &kp GRAVE  &none   &kp UP_ARROW    &kp HOME                  &mkp MB4         &msc MOVE_Y(15)   &none  &kp GRAVE  &none
  &kp TAB         &kp LEFT   &none   &kp RIGHT       &kp END                   &mkp MB5         &mkp LCLK         &none  &mkp RCLK  &mkp MCLK
  &kp LEFT_SHIFT  &none      &none   &kp DOWN_ARROW  &none                     &msc MOVE_X(15)  &msc MOVE_Y(-15)  &none  &none      &msc MOVE_X(-15)
  &trans          &trans     &trans  &trans          &trans    &trans  &trans  &trans                                               &none
            >;
        };

        player_win {
            bindings = <
  &kp K_MUTE  &trans  &trans  &kp C_VOLUME_UP    &trans                  &trans  &trans  &trans  &trans  &trans
  &trans      &trans  &trans  &trans             &trans                  &trans  &trans  &trans  &trans  &trans
  &trans      &trans  &trans  &kp C_VOLUME_DOWN  &trans                  &trans  &trans  &trans  &trans  &trans
  &trans      &trans  &trans  &trans             &trans  &trans  &trans  &trans                          &trans
            >;
        };

        profile_win {
            bindings = <
  &none     &none     &none     &none     &none                     &none   &none  &none  &none  &none
  &btl 0 0  &btl 1 0  &btl 2 0  &btl 3 7  &btl 4 0                  &none   &none  &none  &none  &none
  &none     &none     &none     &none     &none                     &none   &none  &none  &none  &none
  &trans    &trans    &trans    &trans    &trans    &trans  &trans  &trans                       &trans
            >;
        };
    };
};
